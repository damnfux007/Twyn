#!/bin/sh
# Gradle wrapper bootstrap — downloads Gradle if not present
# Run this if you don't have Gradle installed on the server

set -e

GRADLE_VERSION="8.5"
GRADLE_DIR="$HOME/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}"

if [ ! -d "$GRADLE_DIR" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    mkdir -p "$GRADLE_DIR"
    curl -sL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip
    unzip -qo /tmp/gradle.zip -d "$GRADLE_DIR"
    rm /tmp/gradle.zip
fi

GRADLE_BIN=$(find "$GRADLE_DIR" -name "gradle" -path "*/bin/gradle" | head -1)
exec "$GRADLE_BIN" "$@"
